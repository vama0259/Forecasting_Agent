# Copy to .env and fill in. .env is gitignored; never commit real values.

# Angel One SmartAPI — GitHub #30
# ANGELONE_API_KEY / ANGELONE_CLIENT_CODE: from the "Create App" dashboard (smartapi.angelone.in)
# ANGELONE_MPIN: your Angel One trading MPIN
# ANGELONE_TOTP_SECRET: the base32 secret shown under the QR code at smartapi.angelbroking.com/enable-totp
#   (NOT the API key above — a separate secret from a separate setup step)
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_MPIN=
ANGELONE_TOTP_SECRET=
